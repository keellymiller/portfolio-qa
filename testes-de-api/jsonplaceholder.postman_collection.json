{
  "info": {
    "name": "Testes de API - JSONPlaceholder (Kelly Porto)",
    "description": "Testes dos métodos HTTP GET, POST, PUT, PATCH e DELETE na API pública JSONPlaceholder, validando códigos de status, tempo de resposta e conteúdo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://jsonplaceholder.typicode.com" }
  ],
  "item": [
    {
      "name": "CT-API-01 - GET post existente",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/1" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Tempo de resposta menor que 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
        "const body = pm.response.json();",
        "pm.test('Retorna o post de id 1', () => pm.expect(body.id).to.eql(1));",
        "pm.test('Possui os campos userId, id, title e body', () => pm.expect(body).to.have.all.keys('userId','id','title','body'));"
      ]}}]
    },
    {
      "name": "CT-API-02 - GET post inexistente (negativo)",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/9999" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 404 para recurso inexistente', () => pm.response.to.have.status(404));"
      ]}}]
    },
    {
      "name": "CT-API-03 - GET filtrar posts por usuário",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts?userId=1" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const lista = pm.response.json();",
        "pm.test('Retorna 10 posts', () => pm.expect(lista.length).to.eql(10));",
        "pm.test('Todos os posts são do userId 1', () => lista.forEach(p => pm.expect(p.userId).to.eql(1)));"
      ]}}]
    },
    {
      "name": "CT-API-04 - POST criar post",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/posts",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Portfólio de QA\",\n  \"body\": \"Teste de criação de post\",\n  \"userId\": 1\n}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.test('Retorna o título enviado', () => pm.expect(body.title).to.eql('Portfólio de QA'));",
        "pm.test('Gera um id novo', () => pm.expect(body.id).to.eql(101));"
      ]}}]
    },
    {
      "name": "CT-API-05 - PUT atualizar post",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/posts/1",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"id\": 1,\n  \"title\": \"Título atualizado\",\n  \"body\": \"Conteúdo atualizado\",\n  \"userId\": 1\n}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Título foi atualizado', () => pm.expect(pm.response.json().title).to.eql('Título atualizado'));"
      ]}}]
    },
    {
      "name": "CT-API-06 - PATCH atualizar só o título",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/posts/1",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Título parcial\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Título foi alterado', () => pm.expect(body.title).to.eql('Título parcial'));",
        "pm.test('Demais campos foram mantidos', () => pm.expect(body.userId).to.eql(1));"
      ]}}]
    },
    {
      "name": "CT-API-07 - DELETE remover post",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/posts/1" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));"
      ]}}]
    }
  ]
}
